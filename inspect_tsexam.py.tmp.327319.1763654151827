#!/usr/bin/env python3
"""
Quick script to inspect the TimeSeriesExam dataset structure
"""
from datasets import load_dataset

print("Loading AutonLab/TimeSeriesExam1...")
try:
    ds = load_dataset("AutonLab/TimeSeriesExam1", split="train")
    print(f"\n✓ Dataset loaded successfully!")
    print(f"  Total samples: {len(ds)}")
    print(f"\n  Features: {ds.features}")

    # Show first sample
    if len(ds) > 0:
        print(f"\n  First sample:")
        sample = ds[0]
        for key, value in sample.items():
            if isinstance(value, (list, tuple)):
                print(f"    {key}: {type(value).__name__} of length {len(value)}")
                if len(value) > 0 and len(value) <= 3:
                    print(f"      → {value}")
                elif len(value) > 3:
                    print(f"      → First 3 elements: {value[:3]}")
            else:
                print(f"    {key}: {value}")

        # Check if there are samples with different numbers of time series
        print("\n  Checking variability in number of time series...")
        # Try to identify time series fields
        for key in sample.keys():
            if 'series' in key.lower() or 'data' in key.lower():
                print(f"    Found potential time series field: {key}")

except Exception as e:
    print(f"\n✗ Error loading dataset: {e}")
    print(f"  Make sure you have access to AutonLab/TimeSeriesExam1")
